# Set the real public HTTPS origin before a production build.
# Without it, the site asks crawlers not to index the local preview.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: use a persistent, private disk directory for early-access signups.
# The default is .data/ in the project root. Never expose this directory publicly.
# WAITLIST_DATA_DIR=/path/to/private/persistent-data
