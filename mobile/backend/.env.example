# Public app project configuration. Never point to the marketing waitlist project.
SUPABASE_URL=https://YOUR_APP_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_APP_PUBLISHABLE_KEY
APP_ALLOWED_ORIGINS=
# Cloud AI/import are off until deployment/provider/privacy review is complete.
AI_JOBS_ENABLED=false
IMPORT_JOBS_ENABLED=false
# Worker-only secrets belong in Supabase secrets, never Flutter --dart-define.
SUPABASE_SERVICE_ROLE_KEY=
JOB_WORKER_SECRET=
OPENAI_API_KEY=
COACH_MODEL=
# Explicit operator-controlled DNS host allowlist. Redirects are always rejected.
IMPORT_ALLOWED_HOSTS=
# Signed uploads remain private and are gated by explicit verification.
MEDIA_UPLOADS_ENABLED=false
IMAGE_JOBS_ENABLED=false
# RevenueCat SDK app_user_id MUST equal the verified Supabase user ID.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENVIRONMENT=SANDBOX
REVENUECAT_ENTITLEMENT_KEYS=pro
