<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.type.watch" />
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Crispy Crust">
    <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />
    <activity android:name="app.crispycrust.wear.MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name="app.crispycrust.wear.KitchenDataService" android:exported="true">
      <intent-filter><action android:name="com.google.android.gms.wearable.DATA_CHANGED"/><data android:scheme="wear" android:host="*" android:pathPrefix="/crispy/task"/></intent-filter>
      <intent-filter><action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/><data android:scheme="wear" android:host="*" android:pathPrefix="/crispy/ack"/></intent-filter>
    </service>
  </application>
</manifest>
